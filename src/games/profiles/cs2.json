{
  "id": "cs2",
  "name": "Counter-Strike 2",
  "short": "Counter-Strike 2",
  "genre": "Tactical shooter",
  "colors": [
    "#f2a900",
    "#1b2838"
  ],
  "competitive": true,
  "antiCheat": "VAC",
  "platforms": [
    "win32",
    "linux"
  ],
  "detect": {
    "steam": 730,
    "process": [
      "cs2.exe",
      "cs2"
    ],
    "exe": [
      "cs2.exe"
    ]
  },
  "tweaks": {
    "win32": [
      "win-plan-woof",
      "win-game-mode",
      "win-game-dvr-off",
      "win-game-bar-off",
      "win-fso-off",
      "win-visual-fx",
      "win-transparency-off",
      "win-background-apps-off",
      "win-max-refresh",
      "win-ads-off",
      "win-sticky-keys-off",
      "win-hibernate-off",
      "win-tdr-delay",
      "win-fth-off",
      "win-pcie-aspm-off",
      "win-sysmain-off",
      "win-compat-telemetry-off",
      "win-update-no-restart",
      "win-mouse-accel-off",
      "win-pointer-speed-6",
      "win-usb-suspend-off",
      "win-core-parking-off",
      "win-cpu-min-100",
      "win-power-throttling-off",
      "win-windowed-opt",
      "win-vrr",
      "win-gpu-priority",
      "win-priority-separation",
      "win-system-responsiveness",
      "win-network-throttling-off",
      "win-rsc-off",
      "win-nic-eee-off",
      "win-nic-interrupt-mod-off",
      "win-wifi-max-perf",
      "win-wifi-roam-low",
      "win-delivery-opt-off"
    ],
    "linux": [
      "linux-governor-performance",
      "linux-epp-performance",
      "linux-turbo-on",
      "linux-power-profile",
      "linux-gamemode",
      "linux-max-map-count",
      "linux-split-lock-off",
      "linux-swappiness",
      "linux-io-nvme-none",
      "linux-mesa-cache-size",
      "linux-nvidia-powermizer",
      "linux-file-limits",
      "linux-mouse-flat",
      "linux-bbr",
      "linux-tcp-latency"
    ]
  },
  "extras": [
    "fso",
    "gpuPreference",
    "priority",
    "shaderCache",
    "dscp",
    "defender",
    "regionPing"
  ],
  "launchOptions": {
    "steam": "-novid +fps_max 0",
    "linux": "gamemoderun %command% -novid +fps_max 0"
  },
  "settings": [
    {
      "setting": "Display mode",
      "value": "Fullscreen",
      "why": "Lowest input lag and best frame pacing."
    },
    {
      "setting": "NVIDIA Reflex",
      "value": "On + Boost",
      "why": "Cuts system latency the most when your GPU is maxed out (NVIDIA only)."
    },
    {
      "setting": "Boost player contrast",
      "value": "Enabled",
      "why": "Makes enemies easier to see."
    },
    {
      "setting": "Wait for vertical sync",
      "value": "Disabled",
      "why": "Lower input lag."
    },
    {
      "setting": "Multisampling anti-aliasing",
      "value": "4x MSAA (or 2x on weak GPUs)",
      "why": "Good clarity for the cost."
    },
    {
      "setting": "Shader detail / Particle detail",
      "value": "Low",
      "why": "More FPS in smokes and fights."
    },
    {
      "setting": "FidelityFX Super Resolution",
      "value": "Disabled (Highest Quality)",
      "why": "Native resolution is clearer for spotting."
    }
  ],
  "regions": [
    "us-east-1",
    "us-west-2",
    "sa-east-1",
    "eu-west-1",
    "eu-central-1",
    "eu-north-1",
    "ap-southeast-1",
    "ap-southeast-2",
    "ap-northeast-1",
    "ap-south-1",
    "me-south-1",
    "af-south-1"
  ],
  "notes": [
    "Steam: right-click CS2 → Properties → Launch Options."
  ],
  "mono": "CS2"
}