  "launchOptions": {},
  "settings": [
    {
      "setting": "Display mode",
      "value": "Fullscreen",
      "why": "Lowest input lag and best frame pacing."
    },
    {
      "setting": "NVIDIA Reflex",
      "value": "On + Boost",
      "why": "Cuts system latency the most when your GPU is maxed out (NVIDIA only)."
    },
    {
      "setting": "V-Sync",
      "value": "Off",
      "why": "Adds input lag. Use G-Sync/FreeSync + a frame cap instead."
    },
    {
      "setting": "Frame rate limit",
      "value": "Unlimited or 2× your refresh rate",
      "why": "A stable cap gives smoother frame times than uncapped spikes."
    },
    {
      "setting": "Material / Texture / Detail quality",
      "value": "Low",
      "why": "Visual clarity is fine on low and FPS is much higher."
    },
    {
      "setting": "Anti-aliasing",
      "value": "MSAA 2x or None",
      "why": "Cheap enough on most GPUs."
    },
    {
      "setting": "Improve clarity / Bloom / Distortion / Cast shadows",
      "value": "Off",
      "why": "Cleaner image and more FPS."
    },
    {
      "setting": "Raw input buffer",
      "value": "On",
      "why": "Reads your mouse directly."
    }
  ],
