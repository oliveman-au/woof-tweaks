    },
    {
      "setting": "Display mode",
      "value": "Fullscreen",
      "why": "Lowest input lag and best frame pacing."
    },
    {
      "setting": "NVIDIA Reflex",
      "value": "On + Boost",
      "why": "Cuts system latency the most when your GPU is maxed out (NVIDIA only)."
    },
    {
      "setting": "V-Sync",
      "value": "Off",
      "why": "Adds input lag. Use G-Sync/FreeSync + a frame cap instead."
    },
    {
      "setting": "Frame rate limit",
      "value": "Monitor refresh rate (e.g. 144/240)",
      "why": "A stable cap gives smoother frame times than uncapped spikes."
    },
    {
      "setting": "View distance",
      "value": "Medium",
      "why": "Higher costs CPU with little benefit."
    },
    {
      "setting": "Shadows / Ambient occlusion",
      "value": "Off",
      "why": "Large FPS cost."
    },
    {
